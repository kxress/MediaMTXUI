# Bind this mTLS endpoint to an address reachable only from the management network.
MTXUI_AGENT_LISTEN=127.0.0.1:9443
MTXUI_AGENT_AUTH_LISTEN=127.0.0.1:9081
MTXUI_AGENT_API_URL=http://127.0.0.1:9997

# Provision certificates from a CA dedicated to management. The client certificate fingerprint pins the one
# MediaMTXUI instance authorized to call this agent, in addition to CA verification.
MTXUI_AGENT_TLS_CERT=
MTXUI_AGENT_TLS_KEY=
MTXUI_AGENT_CLIENT_CA=
MTXUI_AGENT_CLIENT_CERT_SHA256=

# Configure the matching values on the MediaMTXUI host. The URL must end in /agent/v1/auth and use HTTPS.
MTXUI_AGENT_AUTH_URL=https://dashboard.example/agent/v1/auth
MTXUI_AGENT_ID=
MTXUI_AGENT_AUTH_KEY=

# The agent can access only this file for configuration management. Keep it readable and writable by the agent
# service account; MediaMTX must read the same file. Apply a systemd ReadWritePaths drop-in if it is outside
# /var/lib/mtxui-agent.
MTXUI_AGENT_CONFIG_PATH=/var/lib/mtxui-agent/mediamtx.yml
MTXUI_AGENT_MEDIAMTX_BIN=/usr/bin/mediamtx
MTXUI_AGENT_RECORDINGS_DIR=/var/lib/mtxui-agent/recordings
