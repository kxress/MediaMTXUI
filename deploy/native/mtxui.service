[Unit]
Description=MediaMTX UI control plane
Documentation=https://github.com/greatmastix/MediaMTXUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtxui
Group=mtxui
UMask=0077
EnvironmentFile=/etc/mtxui/mtxui.env
Environment=MTXUI_DEPLOYMENT_MODE=native
ExecStart=/usr/libexec/mtxui/mtxui serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
